@@ -23,7 +23,22 @@ services:
       password: ${COLLABORA_ADMIN_PASSWORD:?}
     volumes:
       - /run/current-system/sw/share/X11/fonts/:/usr/share/fonts/truetype/more:ro
-    cap_add: [SYS_ADMIN]
+    # Collabora sandboxt jeden Dokument-Prozess SELBST (eigene Mount-/PID-
+    # Namespaces + chroot pro Dokument) und braucht dafür SYS_ADMIN, SYS_CHROOT
+    # und MKNOD. Vorher stand hier nur "cap_add: [SYS_ADMIN]" OHNE cap_drop –
+    # der Container hatte also zusätzlich den kompletten Docker-Default-Satz
+    # (NET_RAW, NET_BIND_SERVICE, KILL, AUDIT_WRITE, …). Jetzt: alles weg,
+    # nur das Nötige zurück.
+    cap_drop: [ALL]
+    cap_add: [SYS_ADMIN, SYS_CHROOT, MKNOD, CHOWN, FOWNER, SETGID, SETUID, DAC_OVERRIDE]
+    # seccomp/apparmor bleiben unconfined: die Default-Profile blockieren genau
+    # die mount()/clone()-Aufrufe, mit denen Collabora seine eigene Sandbox baut.
+    # KEIN no-new-privileges: coolwsd erteilt seinen Hilfsprozessen (coolforkit)
+    # Datei-Capabilities; mit NNP schlägt das fehl und der Editor startet nicht.
+    # Damit ist das hier weiterhin der am schwächsten isolierte Container im
+    # Stack – er hängt in traefik-public, also im selben Netz wie alle anderen
+    # Web-Dienste. Wer das enger haben will, muss ihn in ein eigenes Netz legen
+    # (nur wopiserver/opencloud + traefik dürfen ihn erreichen).
     security_opt:
       - seccomp=unconfined
       - apparmor:unconfined
