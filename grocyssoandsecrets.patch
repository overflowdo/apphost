     healthcheck:
-      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:80/ >/dev/null 2>&1 || exit 1"]
+      # Mit aktivem Reverse-Proxy-Auth weist Grocy Requests ohne Remote-User-Header
