logging {
  level = "warn"
}

// Docker Container Logs.
// Zugriff über den socket-proxy (compose/infrastructure/traefik.yml) statt über
// den gemounteten /run/docker.sock: der Proxy lässt nur GET durch (POST=0), das
// reicht für Discovery + Log-Tailing und schließt "Container starten" aus.
discovery.docker "containers" {
  host = "tcp://socket-proxy:2375"
}

discovery.relabel "docker_containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
  // Nur Container mit Logs, keine System-Container ohne Labels
  rule {
    source_labels = ["container"]
    regex         = ".+"
    action        = "keep"
  }
}

loki.source.docker "containers" {
  host       = "tcp://socket-proxy:2375"
  targets    = discovery.relabel.docker_containers.output
  forward_to = [loki.process.drop_noise.receiver]
}

// Verwirft bekannte, harmlose Rausch-Zeilen aus Container-Logs, bevor sie in
// Loki landen (sonst tauchen sie im Fehler-Dashboard auf). Aktuell: cadvisor
// kann das LUKS-btrfs-Root-Device (/dev/mapper/cryptroot) aus seinem Container
// nicht stat-en -> "Unable to get btrfs mountpoint IDs". Rein kosmetisch,
// Container-Metriken werden trotzdem vollständig erfasst.
loki.process "drop_noise" {
  forward_to = [loki.write.loki.receiver]

  stage.drop {
    expression          = ".*Unable to get btrfs mountpoint IDs.*"
    drop_counter_reason = "cadvisor_btrfs_noise"
  }

  // Alloy-Eigenrauschen: transiente Meldung, wenn ein getailter Container
  // neu startet/stoppt und der Log-Stream abreißt (harmlos).
  stage.drop {
    expression          = ".*could not transfer logs.*"
    drop_counter_reason = "alloy_tailer_restart_noise"
  }

  // Alloy remotecfg ist nicht konfiguriert -> "noop client"; die
  // Registrierungs-Fehlermeldung ist folgenlos.
  stage.drop {
    expression          = ".*failed to register collector with remote server.*"
    drop_counter_reason = "alloy_remotecfg_noise"
  }

  // Homepage laeuft mit read_only: true und will seinen Next.js-Prerender-Cache
  // nach /app/.next/server/pages schreiben:
  //   warn: Failed to update prerender cache for /en
  //   Error: EROFS: read-only file system
  // Folgenlos: ohne Cache rendert Next.js die Seite bei jedem Aufruf neu, und
  // das Dashboard hat 17 statische Kacheln. Ein tmpfs an dieser Stelle ginge
  // NICHT - dort liegen die vom Image mitgebrachten Seiten, ein Overlay wuerde
  // sie verdecken. read_only fuer eine Zeile Log aufzugeben lohnt nicht.
  stage.drop {
    expression          = ".*Failed to update prerender cache.*"
    drop_counter_reason = "homepage_prerender_cache_readonly"
  }
}

// Host System Logs aus dem systemd-Journal.
//
// Hier standen vorher zwei loki.source.file auf /var/log/syslog und
// /var/log/auth.log. Beide Dateien gibt es auf NixOS nicht: es läuft kein
// rsyslog, alles liegt im Journal (services.journald mit Storage=persistent,
// siehe nixos/configuration.nix). Die Host-Logs kamen also nie in Loki an –
// dieselbe Klasse Fehler wie das fail2ban-Jail, das auf /var/log/auth.log zeigte.
//
// Voraussetzungen, damit das im Container funktioniert (alle erfüllt):
//   - /var/log ist read-only gemountet, darin liegt /var/log/journal. Nur Lesen
//     nötig; den Cursor legt Alloy unter --storage.path ab. Das ist ein
//     Bind-Mount auf /var/lib/apphost-alloy (root:root) und bewusst kein Named
//     Volume – warum, steht in compose/monitoring/exporters.yml.
//   - Das Alloy-Image setzt bewusst KEIN USER, der Prozess läuft als root und
//     darf die Journal-Dateien (0640 root:systemd-journal) lesen. Der Hinweis in
//     der Alloy-Doku, den alloy-Nutzer in die Gruppen adm/systemd-journal zu
//     stecken, betrifft die Paketinstallation, nicht diesen Fall.
//   - Das Image installiert libsystemd0, die Journal-Unterstützung ist also
//     einkompiliert.
loki.relabel "journal" {
  // Leeres forward_to: diese Komponente existiert nur, um ihre rules zu
  // exportieren (so dokumentiert es Alloy selbst).
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }
  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "syslog_identifier"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
  // Audit-Meldungen NICHT nach Loki. Die Audit-Regeln in
  // nixos/modules/security.nix überwachen unter anderem fehlgeschlagene Lesezugriffe
  // auf /etc; zusammen mit journald Audit=yes wäre das ein Dauerstrom, der die
  // eigentlich interessanten Host-Logs zudeckt. Auf dem Host bleiben sie
  // vollständig erhalten (journalctl _TRANSPORT=audit, außerdem
  // /var/log/audit). Zum Mitschicken: diese Regel entfernen.
  rule {
    source_labels = ["__journal__transport"]
    regex         = "audit"
    action        = "drop"
  }
}

loki.source.journal "host" {
  // Explizit, statt Alloy zwischen /var/log/journal und /run/log/journal wählen
  // zu lassen: nur das persistente Verzeichnis ist in den Container gemountet.
  path          = "/var/log/journal"
  // Nach einem längeren Ausfall nicht das komplette Journal nachladen.
  max_age       = "12h"
  relabel_rules = loki.relabel.journal.rules
  labels        = {job = "systemd-journal"}
  forward_to    = [loki.write.loki.receiver]
}

// Traefik-Access-Log.
// Seit accessLog.filePath gesetzt ist (nötig für das fail2ban-Jail traefik-auth),
// schreibt Traefik die Zugriffe NUR NOCH in die Datei und nicht mehr nach stdout.
// Über den Container-Log-Weg kamen sie damit nicht mehr in Loki an. Alloy mountet
// /var/log ohnehin read-only, also von dort direkt einlesen.
// Die Grafana-Dashboards sind davon unabhängig (die nutzen
// traefik_service_requests_total aus Prometheus), im Log-Explorer fehlten sie aber.
local.file_match "traefik_access" {
  path_targets = [{
    __path__ = "/var/log/traefik/access.log",
    job      = "traefik-access",
    host     = "apphost",
  }]
}

loki.source.file "traefik_access" {
  targets    = local.file_match.traefik_access.targets
  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
