logging {
  level = "warn"
}

// Docker Container Logs.
// Zugriff über den socket-proxy (compose/infrastructure/traefik.yml) statt über
// den gemounteten /run/docker.sock: der Proxy lässt nur GET durch (POST=0), das
// reicht für Discovery + Log-Tailing und schließt "Container starten" aus.
discovery.docker "containers" {
  host = "tcp://socket-proxy:2375"
}

discovery.relabel "docker_containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
  // Nur Container mit Logs, keine System-Container ohne Labels
  rule {
    source_labels = ["container"]
    regex         = ".+"
    action        = "keep"
  }
}

loki.source.docker "containers" {
  host       = "tcp://socket-proxy:2375"
  targets    = discovery.relabel.docker_containers.output
  forward_to = [loki.process.drop_noise.receiver]
}

// Verwirft bekannte, harmlose Rausch-Zeilen aus Container-Logs, bevor sie in
// Loki landen (sonst tauchen sie im Fehler-Dashboard auf). Aktuell: cadvisor
// kann das LUKS-btrfs-Root-Device (/dev/mapper/cryptroot) aus seinem Container
// nicht stat-en -> "Unable to get btrfs mountpoint IDs". Rein kosmetisch,
// Container-Metriken werden trotzdem vollständig erfasst.
loki.process "drop_noise" {
  forward_to = [loki.write.loki.receiver]

  stage.drop {
    expression          = ".*Unable to get btrfs mountpoint IDs.*"
    drop_counter_reason = "cadvisor_btrfs_noise"
  }

  // Alloy-Eigenrauschen: transiente Meldung, wenn ein getailter Container
  // neu startet/stoppt und der Log-Stream abreißt (harmlos).
  stage.drop {
    expression          = ".*could not transfer logs.*"
    drop_counter_reason = "alloy_tailer_restart_noise"
  }

  // Alloy remotecfg ist nicht konfiguriert -> "noop client"; die
  // Registrierungs-Fehlermeldung ist folgenlos.
  stage.drop {
    expression          = ".*failed to register collector with remote server.*"
    drop_counter_reason = "alloy_remotecfg_noise"
  }
}

// Host System Logs
local.file_match "syslog" {
  path_targets = [{
    __path__ = "/var/log/syslog",
    job      = "syslog",
    host     = "apphost",
  }]
}

loki.source.file "syslog" {
  targets    = local.file_match.syslog.targets
  forward_to = [loki.write.loki.receiver]
}

local.file_match "auth" {
  path_targets = [{
    __path__ = "/var/log/auth.log",
    job      = "auth",
    host     = "apphost",
  }]
}

loki.source.file "auth" {
  targets    = local.file_match.auth.targets
  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
