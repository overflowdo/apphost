.DS_Store
.AppleDouble
.LSOverride
._*^
.Spotlight-V8
.Trashes

# Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Generierte Secrets (Authelia, Ntfy, Vaultwarden-Token etc.) – niemals committen
secrets/

