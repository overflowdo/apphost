# Temporäre Dateien
tmp/
temp/
*.tmp

# Backup-Dateien
*.bak
*.backup

# Patch-/Diff-Artefakte. Landen beim Ein- und Ausspielen von Reviews im
# Repo-Root und wurden schon mehrfach versehentlich mitcommittet
# (0001fixdeploypaths.patch, mediadirsoneshot.patch, installpasswordprompts.patch,
# apphostsecurityfixescombined.diff).
*.patch
*.diff
*.rej
*.orig

# NixOS maschinenspezifische Dateien (von install.sh pro Installation generiert)
hardware-configuration.nix
nixos/ssh-key.nix
nixos/disk-encryption.nix
